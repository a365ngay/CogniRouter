{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-compass.local/schemas/task-spec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "objective",
    "context",
    "allowed_files",
    "forbidden_files",
    "implementation_requirements",
    "constraints",
    "commands_allowed",
    "verification",
    "acceptance_criteria",
    "risk_level",
    "expected_outputs"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "parent_task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "allowed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "forbidden_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "implementation_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "commands_allowed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "failed_acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "targeted_fix": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "stack": {
      "type": "string"
    },
    "expected_outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

